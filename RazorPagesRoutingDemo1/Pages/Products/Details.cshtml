@page "{id:int}"
@model RazorPagesRoutingDemo1.Pages.Products.DetailsModel

<h2>Product Details</h2>

@if (Model.Product != null)
{
    <p><strong>Name:</strong> @Model.Product.Name</p>
    <p><strong>Category:</strong> @Model.Product.Category</p>
    <p><strong>Price:</strong> $@Model.Product.Price</p>
    <p><strong>Stock:</strong> @Model.Product.Stock</p>

    @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
    {
        <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" style="max-width:300px;" />
    }
}
else
{
    <p class="text-danger">Product not found.</p>
}
