@page
@model RazorPagesRoutingDemo1.Pages.Products.IndexModel
using RazorPagesRoutingDemo1.Models;


<h2>Products</h2>

<form method="get" class="mb-3">

    <input type="text"
           name="SearchTerm"
           value="@Model.SearchTerm"
           placeholder="Search products..."
           class="form-control mb-2" />

    <select name="Category" class="form-select mb-2">
        <option value="">All Categories</option>

        @foreach (var cat in Model.Categories)
        {
            <option value="@cat" selected="@(Model.Category == cat)">
                @cat
            </option>
        }
    </select>

    <button type="submit" class="btn btn-primary">Search</button>
    <a href="/Products" class="btn btn-secondary">Clear</a>

</form>

<ul class="list-unstyled">
    @foreach (var p in Model.Products)
    {
        <li class="mb-3 d-flex align-items-center">
            <img src="@p.ImageUrl" alt="@p.Name" width="80" class="me-3" />
            <span>@p.Name</span>
        </li>
    }
</ul>

